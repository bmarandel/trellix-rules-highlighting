{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Trellix Expert Rules",
  "scopeName": "source.trellix.expertrules",
  "comment": "GENERATED by tools/build.py from grammar/expert-rules.json \u2014 do not edit by hand.",
  "patterns": [
    {
      "include": "#body"
    }
  ],
  "repository": {
    "body": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#access-string"
        },
        {
          "include": "#enum-string"
        },
        {
          "include": "#string"
        },
        {
          "include": "#command-substitution"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#legacy"
        },
        {
          "include": "#structure"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#tcl"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#options"
        },
        {
          "include": "#number"
        },
        {
          "include": "#escape"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.expertrules"
        }
      ]
    },
    "comment": {
      "comment": "In Tcl, # starts a comment only where a command starts: line start or after ';'.",
      "match": "(?:^|(?<=;))\\s*((#).*$)",
      "captures": {
        "1": {
          "name": "comment.line.number-sign.expertrules"
        },
        "2": {
          "name": "punctuation.definition.comment.expertrules"
        }
      }
    },
    "access-string": {
      "comment": "-access \"CREATE WRITE\": tokens separated by space, tab, comma or |",
      "begin": "(?<![\\w-])(-access)\\s+(\\\")",
      "beginCaptures": {
        "1": {
          "name": "variable.parameter.option.expertrules"
        },
        "2": {
          "name": "string.quoted.double.expertrules punctuation.definition.string.begin.expertrules"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.expertrules punctuation.definition.string.end.expertrules"
        }
      },
      "contentName": "string.quoted.double.expertrules",
      "patterns": [
        {
          "match": "(?i)(?<![\\w-])(?:CONNECT_NAMED_PIPE|OPEN_NAMEDSECTION|OPEN_FOR_DELETE|SET_FILE_LENGTH|WRITE_ATTRIBUTE|OBJECT_EXISTS|SET_SECURITY|START_DEVICE|REPLACE_KEY|RESTORE_KEY|SET_REPARSE|TERMINATING|LOAD_IMAGE|LOCK_RANGE|WRITE_DATA|READ_DATA|LOAD_KEY|CLEANUP|EXECUTE|CREATE|DELETE|RENAME|CLOSE|QUERY|WRITE|ENUM|POST|READ)(?![\\w-])",
          "name": "constant.language.access.expertrules"
        },
        {
          "match": "[,|]",
          "name": "punctuation.separator.expertrules"
        }
      ]
    },
    "enum-string": {
      "comment": "-file_properties / -file_attributes / -nt_access \"...\"",
      "begin": "(?<![\\w-])(-file_properties|-file_attributes|-nt_access)\\s+(\\\")",
      "beginCaptures": {
        "1": {
          "name": "variable.parameter.option.expertrules"
        },
        "2": {
          "name": "string.quoted.double.expertrules punctuation.definition.string.begin.expertrules"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.expertrules punctuation.definition.string.end.expertrules"
        }
      },
      "contentName": "string.quoted.double.expertrules",
      "patterns": [
        {
          "match": "!",
          "name": "keyword.operator.negation.expertrules"
        },
        {
          "match": "(?<![\\w-])(?:MAPPED_TO_ALL_PROCESSES|DAC_CONTAIN_PID_BITS|FILE_REDIRECTOR|MULTI_PARTITION|NOT_PARTITIONED|PRIVILEGE_IOCTL|FILE_REMOVABLE|PRIVILEGE_ISG|FILE_NETWORK|FILE_FLOPPY|SYSTEM_MODE|REDIRECTOR|DIRECTORY|PARTITION|REMOVABLE|TEMPORARY|FILE_DFS|READONLY|ARCHIVE|FILE_CD|NETWORK|FLOPPY|HIDDEN|NORMAL|SYSTEM|kernel|false|true|user|DFS|MBR|VBR|CD)(?![\\w-])",
          "name": "constant.language.enum.expertrules"
        },
        {
          "include": "#number"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.expertrules"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.expertrules"
        }
      },
      "name": "string.quoted.double.expertrules",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#command-substitution"
        },
        {
          "include": "#variable"
        },
        {
          "match": "(?<![\\w-])(?:HKEY_CURRENT_CONFIG|HKEY_LOCAL_MACHINE|HKEY_CLASSES_ROOT|HKEY_CURRENT_USER|HKEY_USERS|HKULMS|HKALL|HKCCS|HKCUC|HKCUS|HKLMS|HKULM|HKCC|HKCR|HKCU|HKLM|HKUS|HKU)(?![\\w-])",
          "name": "support.constant.registry-root.expertrules"
        },
        {
          "match": "(?<![\\w-])(?:bo:call_different_target_address|illegal_api_use:bad_parameter|illegal_api_use:invalid_call|bo:call_return_unreadable|services:profile_disable|services:profile_enable|bo:call_return_to_api|bo:writeable_memory|bo:call_not_found|services:continue|services:startup|bo:invalid_call|bo:target_bytes|services:create|services:delete|services:logon|services:pause|services:start|services:stop|bo:stack|bo:heap)(?![\\w-])",
          "name": "constant.language.directive.expertrules"
        },
        {
          "match": "\\*\\*|[*?&]",
          "name": "keyword.operator.wildcard.expertrules"
        },
        {
          "match": "!",
          "name": "constant.character.escape.wildcard.expertrules"
        }
      ]
    },
    "escape": {
      "match": "\\\\(?:.|$)",
      "name": "constant.character.escape.expertrules"
    },
    "variable": {
      "patterns": [
        {
          "match": "(\\$)\\{[^}]*\\}",
          "name": "variable.other.expertrules",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.expertrules"
            }
          }
        },
        {
          "match": "(\\$)(?:::)?[A-Za-z0-9_]+(?:::[A-Za-z0-9_]+)*",
          "name": "variable.other.expertrules",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.expertrules"
            }
          }
        }
      ]
    },
    "command-substitution": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.expertrules"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.expertrules"
        }
      },
      "name": "meta.command-substitution.expertrules",
      "patterns": [
        {
          "include": "#body"
        }
      ]
    },
    "braces": {
      "patterns": [
        {
          "match": "\\{",
          "name": "punctuation.section.braces.begin.expertrules"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.braces.end.expertrules"
        }
      ]
    },
    "structure": {
      "patterns": [
        {
          "comment": "Match <object type>",
          "match": "(?<![\\w-])(Match)\\s+(REGISTRY|PROCESS|SECTION|THREAD|VALUE|DISK|FILE|KEY)(?![\\w-])",
          "captures": {
            "1": {
              "name": "keyword.control.structure.expertrules"
            },
            "2": {
              "name": "entity.name.type.object-type.expertrules"
            }
          }
        },
        {
          "match": "(?<![\\w-])(?:Next_Process_Behavior|AggregateMatch|Description|Initiator|Reaction|Exclude|Include|Process|Policy|Target|Group|Match|Rule)(?![\\w-])",
          "name": "keyword.control.structure.expertrules"
        },
        {
          "match": "(?<![\\w-])(?:REGISTRY|PROCESS|SECTION|THREAD|VALUE|DISK|FILE|KEY)(?![\\w-])",
          "name": "entity.name.type.object-type.expertrules"
        },
        {
          "match": "(?<![\\w-])(?:REMOTE_MACHINE_ADDRESS|IMAGE_BASE_ADDRESS|KERNEL_CALLER_NAME|PROCESS_STATE_BITS|TARGET_OBJECT_NAME|AUTHENTICATION_ID|CERT_NAME_CHAINED|IMAGE_ENTRY_POINT|IMAGE_PROPERTIES|OPERATION_STATUS|PROCESS_CMD_LINE|STORAGE_BUS_TYPE|VERSION_RESOURCE|CACHE_ATTRIBUTE|FILE_ATTRIBUTES|FILE_PROPERTIES|PARTITION_STYLE|NT_ACCESS_MASK|PROCESSOR_MODE|VTP_PRIVILEGES|EXP_USER_NAME|IS_TRANSACTED|IS_DIRECTORY|LBA_FROM_END|PRODUCT_NAME|ACCESS_MASK|DESCRIPTION|DISKIO_HOOK|DISK_REGION|OBJECT_NAME|OBJECT_SIZE|PE_SHA2_256|PE_SHA2_384|PE_SHA2_512|REGVAL_DATA|DLL_LOADED|FILE_ATIME|FILE_CTIME|FILE_MTIME|GROUP_NAME|OS_VERSION|PROCESS_ID|SESSION_ID|CERT_HASH|CERT_NAME|GROUP_SID|THREAD_ID|USER_NAME|VTP_TRUST|LBA2FILE|SHA2_256|SHA2_384|SHA2_512|USER_SID|ENV_VAR|PE_SHA1|VERSION|PE_MD5|WOW64|SHA1|LBA|MD5|PE)(?![\\w-])",
          "name": "support.type.match-type.expertrules"
        },
        {
          "comment": "-type <data type>",
          "match": "(?<![\\w-])(-type)\\s+(EXPANDABLE_STRING|MULTI_STRING|BITMASK|BINARY|STRING|UINT16|UINT32|UINT64|INT16|INT32|INT64|UINT8|INT8|PATH)(?![\\w-])",
          "captures": {
            "1": {
              "name": "variable.parameter.option.expertrules"
            },
            "2": {
              "name": "storage.type.data-type.expertrules"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "(?<![\\w-])(iReg)(?:\\s+(-32))?\\s+(v_exists|exist|value|keys|open)(?![\\w-])",
          "captures": {
            "1": {
              "name": "support.function.builtin.expertrules"
            },
            "2": {
              "name": "variable.parameter.option.expertrules"
            },
            "3": {
              "name": "support.constant.subcommand.expertrules"
            }
          }
        },
        {
          "match": "(?<![\\w-])(iSystem)(?:\\s+(-32))?\\s+(users_folders|install_dir|sys32_dir|cpu_arch|platform|os_arch|version|build|major|minor|type|csd)(?![\\w-])",
          "captures": {
            "1": {
              "name": "support.function.builtin.expertrules"
            },
            "2": {
              "name": "variable.parameter.option.expertrules"
            },
            "3": {
              "name": "support.constant.subcommand.expertrules"
            }
          }
        },
        {
          "match": "(?<![\\w-])(iUser)(?:\\s+(-32))?\\s+(groups|list)(?![\\w-])",
          "captures": {
            "1": {
              "name": "support.function.builtin.expertrules"
            },
            "2": {
              "name": "variable.parameter.option.expertrules"
            },
            "3": {
              "name": "support.constant.subcommand.expertrules"
            }
          }
        },
        {
          "match": "(?<![\\w-])(iUtil)(?:\\s+(-32))?\\s+(cvt2args)(?![\\w-])",
          "captures": {
            "1": {
              "name": "support.function.builtin.expertrules"
            },
            "2": {
              "name": "variable.parameter.option.expertrules"
            },
            "3": {
              "name": "support.constant.subcommand.expertrules"
            }
          }
        },
        {
          "match": "(?<![\\w-])(?:iTerminate|iSystem|iDump|iList|iUser|iUtil|iEnv|iReg)(?![\\w-])",
          "name": "support.function.builtin.expertrules"
        }
      ]
    },
    "tcl": {
      "patterns": [
        {
          "match": "(?<![\\w-])(?:continue|foreach|elseif|return|switch|break|catch|while|else|proc|then|for|if)(?![\\w-])",
          "name": "keyword.control.tcl.expertrules"
        },
        {
          "match": "(?:^|(?<=[;{\\[]))\\s*(lreplace|lappend|llength|lsearch|append|concat|format|global|lindex|lrange|regexp|regsub|string|lsort|split|unset|upvar|expr|incr|info|join|list|set)(?![\\w-])",
          "captures": {
            "1": {
              "name": "support.function.tcl.expertrules"
            }
          }
        }
      ]
    },
    "legacy": {
      "patterns": [
        {
          "match": "(?:^|(?<=[;{\\[]))\\s*(Class)\\s+(Buffer_Overflow|Illegal_API_Use|Services|[A-Za-z_]+)",
          "captures": {
            "1": {
              "name": "keyword.other.section.legacy.expertrules"
            },
            "2": {
              "name": "entity.name.class.legacy.expertrules"
            }
          }
        },
        {
          "match": "(?:^|(?<=[;{\\[]))\\s*(detailed_event_info|Vulnerability_Name|vulnerability_name|caller\\ module|display_names|dependencies|application|Executable|attributes|directives|user_name|services|Class|files|level|time|tag|Id)(?![\\w-])",
          "captures": {
            "1": {
              "name": "keyword.other.section.legacy.expertrules"
            }
          }
        },
        {
          "match": "(?<![\\w-])(?:(?:illegal_api_use|services|files|bo):)+[a-z_]+(?![\\w-])",
          "name": "constant.language.directive.expertrules"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(?<![\\w-])(?:REPORT_CLEAN_DELETE_PROCESS|REPORT_DELETE_PROCESS|CLEAN_DELETE_PROCESS|REPORT_CLEAN_PROCESS|DELETE_PROCESS|TARGET_PROCESS|ACTOR_PROCESS|CLEAN_PROCESS|ScanAction|REPORT|BLOCK|SCAN)(?![\\w-])",
          "name": "constant.language.reaction.expertrules"
        },
        {
          "match": "(?<![\\w-])(?:CONNECT_NAMED_PIPE|OPEN_NAMEDSECTION|OPEN_FOR_DELETE|SET_FILE_LENGTH|WRITE_ATTRIBUTE|OBJECT_EXISTS|SET_SECURITY|START_DEVICE|REPLACE_KEY|RESTORE_KEY|SET_REPARSE|TERMINATING|LOAD_IMAGE|LOCK_RANGE|WRITE_DATA|READ_DATA|LOAD_KEY|CLEANUP|EXECUTE|CREATE|DELETE|RENAME|CLOSE|QUERY|WRITE|ENUM|POST|READ)(?![\\w-])",
          "name": "constant.language.access.expertrules"
        },
        {
          "match": "(?<![\\w-])(?:HKEY_CURRENT_CONFIG|HKEY_LOCAL_MACHINE|HKEY_CLASSES_ROOT|HKEY_CURRENT_USER|HKEY_USERS|HKULMS|HKALL|HKCCS|HKCUC|HKCUS|HKLMS|HKULM|HKCC|HKCR|HKCU|HKLM|HKUS|HKU)(?![\\w-])",
          "name": "support.constant.registry-root.expertrules"
        },
        {
          "match": "(?<![\\w-])(?:MAPPED_TO_ALL_PROCESSES|DAC_CONTAIN_PID_BITS|FILE_REDIRECTOR|MULTI_PARTITION|NOT_PARTITIONED|PRIVILEGE_IOCTL|FILE_REMOVABLE|PRIVILEGE_ISG|FILE_NETWORK|FILE_FLOPPY|SYSTEM_MODE|REDIRECTOR|DIRECTORY|PARTITION|REMOVABLE|TEMPORARY|FILE_DFS|READONLY|ARCHIVE|FILE_CD|NETWORK|FLOPPY|HIDDEN|NORMAL|SYSTEM|kernel|false|true|user|DFS|MBR|VBR|CD)(?![\\w-])",
          "name": "constant.language.enum.expertrules"
        }
      ]
    },
    "options": {
      "patterns": [
        {
          "match": "(?<![\\w-])(?:\\-file_attributes|\\-file_properties|\\-no_trusted_apps|\\-processor_mode|\\-not_auditable|\\-no_defaults|\\-nt_access|\\-vtp_trust|\\-inactive|\\-access|\\-no_log|\\-xtype|\\-desc|\\-hash|\\-name|\\-path|\\-type|\\-pfx|\\-sdn|\\-sfx|\\-32|\\-id|\\-d|\\-l|\\-v)(?![\\w-])",
          "name": "variable.parameter.option.expertrules"
        },
        {
          "comment": "unknown -option: still an option",
          "match": "(?<![\\w\\\\-])-[a-z][a-z0-9_]*(?![\\w-])",
          "name": "variable.parameter.option.expertrules"
        }
      ]
    },
    "number": {
      "match": "(?<![\\w.$\\\\-])(?:0[xX][0-9A-Fa-f]+|\\d+)(?![\\w.])",
      "name": "constant.numeric.expertrules"
    }
  }
}
