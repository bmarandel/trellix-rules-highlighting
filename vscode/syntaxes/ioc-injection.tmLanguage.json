{
  "comment": "GENERATED by tools/build.py from grammar/ioc-rules.json",
  "scopeName": "trellix.ioc.injection",
  "injectionSelector": "L:text.xml.trellix.openioc string.quoted, L:source.json.trellix.hxrule string.quoted.double.json, L:source.json.trellix.hxrule support.type.property-name.json",
  "patterns": [
    {
      "match": "(?<![\\w/])(?:eventItem/)?(?:addressNotificationEvent/(?:timestamp|address)|dnsLookupEvent/(?:processPath|timestamp|hostname|username|process|pid)|fileWriteEvent/(?:lowestFileOffsetSeen|numBytesSeenWritten|dataAtLowestOffset|textAtLowestOffset|parentProcessPath|fileExtension|openDuration|eventReason|processPath|devicePath|parentPid|timestamp|fileName|filePath|fullPath|openTime|username|process|closed|writes|drive|error|size|md5|pid)|imageLoadEvent/(?:fileExtension|processPath|devicePath|parentPid|timestamp|fileName|filePath|fullPath|username|process|drive|error|pid)|ipv4NetworkEvent/(?:processPath|remotePort|localPort|timestamp|protocol|remoteIP|username|localIP|process|pid)|processEvent/(?:parentProcessPath|processCmdLine|parentProcess|processPath|eventType|parentPid|startTime|timestamp|username|process|md5|pid)|regKeyEvent/(?:originalPath|processPath|eventType|timestamp|valueName|valueType|username|keyPath|process|value|hive|path|text|pid)|urlMonitorEvent/(?:remoteIpAddress|processPath|httpHeader|remotePort|requestUrl|localPort|timestamp|urlMethod|userAgent|hostname|username|process|error|pid))(?![\\w/])",
      "name": "support.function.ioc-token.ioc"
    },
    {
      "match": "(?<![\\w/])(?:eventItem/)?[a-z][A-Za-z0-9]*Event/[A-Za-z0-9]+(?![\\w/])",
      "name": "invalid.illegal.unknown-token.ioc"
    },
    {
      "comment": "Other OpenIOC terms (FileItem/..., ProcessItem/...): valid OpenIOC, not HX real-time events",
      "match": "(?<![\\w/])[A-Z][A-Za-z]*Item(?:/[A-Za-z0-9]+)+(?![\\w/])",
      "name": "support.type.openioc-item.ioc"
    },
    {
      "match": "(?<=[\"\\'])(?:greater\\-than|starts\\-with|ends\\-with|less\\-than|contains|between|matches|equal|is)(?=[\"\\'])",
      "name": "keyword.operator.ioc"
    },
    {
      "match": "(?<=[\"\\'])(?:AND|OR)(?=[\"\\'])",
      "name": "keyword.operator.logical.ioc"
    },
    {
      "match": "(?<=[\"\\'])(?:execution|presence)(?=[\"\\'])",
      "name": "keyword.control.condition-type.ioc"
    },
    {
      "match": "(?<=[\"\\'])(?:integer|double|string|range|bool|date|text|int|md5|ip)(?=[\"\\'])",
      "name": "storage.type.ioc"
    },
    {
      "match": "(?<=[\"\\'])(?:linux|osx|win)(?=[\"\\'])",
      "name": "constant.language.platform.ioc"
    }
  ]
}
